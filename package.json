{
  "name": "3dshop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push && node prisma/seed.js && node scripts/backfill-email-verified.cjs && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:security": "vitest run tests/security"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.1",
    "@vercel/blob": "^2.7.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.8",
    "next": "14.2.35",
    "nodemailer": "^6.10.1",
    "prisma": "^5.22.0",
    "react": "^18",
    "react-dom": "^18",
    "rss-parser": "^3.13.0",
    "sharp": "^0.33.5",
    "swagger-ui-react": "^5.32.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jsdom": "^30.0.1",
    "next-sitemap": "^4.2.3",
    "playwright": "^1.62.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.8"
  }
